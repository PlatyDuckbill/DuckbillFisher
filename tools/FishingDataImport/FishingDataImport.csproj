<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(DALAMUD_HOME)</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <_DuckbillRequiredReference Include="Lumina;Lumina.Excel" />
    <Reference Include="Lumina"><HintPath>$(DalamudLibPath)/Lumina.dll</HintPath></Reference>
    <Reference Include="Lumina.Excel"><HintPath>$(DalamudLibPath)/Lumina.Excel.dll</HintPath></Reference>
    <ProjectReference Include="../../src/DuckbillFisher.Core/DuckbillFisher.Core.csproj" />
  </ItemGroup>
  <Import Project="../../build/DalamudReferences.targets" />
</Project>
