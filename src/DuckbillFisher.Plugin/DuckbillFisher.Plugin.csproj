<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <AssemblyName>DuckbillFisher</AssemblyName>
    <RootNamespace>DuckbillFisher.Plugin</RootNamespace>
    <Version>0.6.0.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
    <Author>PlatyDuckbill</Author>
    <Name>DuckbillFisher</Name>
    <Punchline>Let Duckbill guide your next catch.</Punchline>
    <Changelog>• Browse fish to target now, prepare ahead, or rare opportunities, with clear recommendation reasons.&#xA;• Read a stable recommendation list and refresh it for the current time when ready.&#xA;• Get local chat notices with detail links for uncaught big and legendary fish at the current hole.&#xA;• Set spawn alerts from 0 to 120 minutes ahead; new settings notify at the start.</Changelog>
    <Description>Let Duckbill guide your next catch.&#xA;A fishing companion for FFXIV Korea.&#xA;&#xA;• Browse fish with collection, region and availability filters.&#xA;• Choose fish to pursue with fresh-start preparation recommendations.&#xA;• Plan spawns with a timeline and monthly calendar.&#xA;• Check baits, mooch chains and time/weather conditions.&#xA;• Prepare baits for favorites or filtered fish, with inventory counts.&#xA;• Find owned baits with page markers and in-game UI highlights.&#xA;• Open fishing spots directly on the map.&#xA;• Get local alerts for favorites and uncaught trophy fish at the current hole, with optional sounds.&#xA;• See fish available now or soon in the quick list.&#xA;• Follow casts with a timer and personal fishing records.&#xA;&#xA;Open: /dbfs or /duckbillfisher. /dbfs cl: compact list; /dbfs ct: casting timer.&#xA;UI: English / Korean. Game names follow your client.&#xA;&#xA;Verified on the supported Korean client and Dalamud build only.&#xA;Does not automate fishing.</Description>
    <RepoUrl>https://github.com/PlatyDuckbill/DuckbillFisher</RepoUrl>
    <Tags>fishing;fish;collection;Korea;한국어</Tags>
    <IconUrl>https://raw.githubusercontent.com/PlatyDuckbill/DuckbillFisher/v$(Version)/assets/duckbillfisher-icon.png</IconUrl>
    <DalamudApiLevel>15</DalamudApiLevel>
    <ApplicableVersion>any</ApplicableVersion>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <_DuckbillRequiredReference Include="Dalamud;Dalamud.Bindings.ImGui;Dalamud.Bindings.ImPlot;Dalamud.Bindings.ImGuizmo;FFXIVClientStructs;InteropGenerator.Runtime;Newtonsoft.Json;Lumina;Lumina.Excel;Serilog;Microsoft.Extensions.ObjectPool" />
    <ProjectReference Include="../DuckbillFisher.Core/DuckbillFisher.Core.csproj" />
    <EmbeddedResource Include="../../data/fishing.kr.v2.json" LogicalName="DuckbillFisher.FishingData" />
    <EmbeddedResource Include="../../data/fish-classifications.kr.v1.json" LogicalName="DuckbillFisher.FishClassifications" />
    <EmbeddedResource Include="../../THIRD-PARTY-NOTICES.txt" LogicalName="DuckbillFisher.ThirdPartyNotices" />
  </ItemGroup>
  <Import Project="../../build/DalamudReferences.targets" />
</Project>
