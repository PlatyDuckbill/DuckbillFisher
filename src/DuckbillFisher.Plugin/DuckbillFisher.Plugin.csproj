<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <AssemblyName>DuckbillFisher</AssemblyName>
    <RootNamespace>DuckbillFisher.Plugin</RootNamespace>
    <Version>0.1.8.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
    <Author>PlatyDuckbill</Author>
    <Name>DuckbillFisher</Name>
    <Punchline>한국 서버 터주 도우미 — 개발 준비 버전</Punchline>
    <Description>어종 목록·상세 조건·지도 핀·즐겨찾기·수동 수집 필터를 제공합니다. 조사한 KR 빌드에서 수첩 조회와 새 어종 등록으로 수집됨을 자동 반영하는 개발 버전입니다. 자동 미수집 판정과 타이머는 아직 없습니다. /duckbillfisher로 창을 엽니다.</Description>
    <RepoUrl>https://github.com/PlatyDuckbill/DuckbillFisher</RepoUrl>
    <Tags>fishing;한국어</Tags>
    <DalamudApiLevel>15</DalamudApiLevel>
    <ApplicableVersion>any</ApplicableVersion>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DuckbillFisher.Core/DuckbillFisher.Core.csproj" />
    <EmbeddedResource Include="../../data/fishing.kr.v1.json" LogicalName="DuckbillFisher.FishingData" />
    <EmbeddedResource Include="../../THIRD-PARTY-NOTICES.txt" LogicalName="DuckbillFisher.ThirdPartyNotices" />
  </ItemGroup>
</Project>
